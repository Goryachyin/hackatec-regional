DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Desarrollo: el código aparece en la consola del backend. Nunca en la API.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para envío real: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=registro@localhost
IDP_BOT_URL=http://127.0.0.1:8001
IDP_API_KEY=local-development-key
IDP_TIMEOUT=120
