DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
# En producción, Supabase Storage debe tener un bucket privado y credenciales S3.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
# Desarrollo: el código aparece en la consola del backend. Nunca en la API.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para envío real: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=registro@localhost
IDP_BOT_URL=https://hackatec-idp-bot.onrender.com
IDP_API_KEY=
IDP_TIMEOUT=120
