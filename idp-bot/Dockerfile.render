FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp IDP_ENV=production IDP_PROVIDER=openai
WORKDIR /app
COPY requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt
COPY main.py processor.py openai_processor.py start.py ./
USER 10001:10001
EXPOSE 10000
CMD ["python", "start.py"]
